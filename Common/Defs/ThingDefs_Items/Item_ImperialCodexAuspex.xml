<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Imperial codex-auspex. Sold to the Empire's tribute collectors it earns royal favor (RoyalFavorValue, see
	     Patches/Traders_ImperialCodexAuspex.xml); studied by a colonist where it lies, it gives a random imperial techprint
	     (CompUseEffect_ImperialBlueprint). A justiciar leaves one after a mission he was treated well on (MissionRecord). -->
	<ThingDef ParentName="ResourceBase">
		<defName>MJV_ImperialCodexAuspex</defName>
		<label>imperial codex-auspex</label>
		<description>A heavy-duty tactical terminal carried by imperial Justiciars and the Imperial elite. Bound by active eltex circuits, it stores codified imperial scripture, judicial mandates, and lost high-tier tech schematics. Returning this terminal to the royal court grants substantial royal favor, or a colonist can analyze its data lattices to unlock a lost imperial blueprint.</description>
		<thingClass>ThingWithComps</thingClass>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Item/Special/MJV_ImperialCodexAuspex</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.7, 0.7)</drawSize>
		</graphicData>
		<stackLimit>1</stackLimit>
		<tickerType>Never</tickerType>
		<useHitPoints>true</useHitPoints>
		<healthAffectsPrice>false</healthAffectsPrice>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<MarketValue>1900</MarketValue>
			<Mass>1.2</Mass>
			<Flammability>1</Flammability>
			<DeteriorationRate>1.5</DeteriorationRate>
			<Beauty>6</Beauty>
			<RoyalFavorValue>10</RoyalFavorValue>
		</statBases>
		<thingCategories>
			<li>ItemsMisc</li>
		</thingCategories>
		<tradeTags>
			<li>ExoticMisc</li>
			<li>MJV_ImperialCodexAuspex</li>
		</tradeTags>
		<thingSetMakerTags>
			<li>RewardStandardMidFreq</li>
		</thingSetMakerTags>
		<comps>
			<li Class="CompProperties_Usable">
				<useJob>UseItem</useJob>
				<useLabel>Study {0_label}</useLabel>
				<useDuration>1500</useDuration>
			</li>
			<li Class="JusticiarValor.CompProperties_UseEffectImperialBlueprint">
				<factionCategoryTags>
					<li>Empire</li>
				</factionCategoryTags>
			</li>
			<li Class="CompProperties_UseEffectDestroySelf" />
		</comps>
	</ThingDef>

</Defs>
