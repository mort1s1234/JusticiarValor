<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Promachos Armor -->
	<ThingDef ParentName="ArmorMachineableBase">
		<defName>MJV_Apparel_PromachosArmor</defName>
		<label>promachos armor</label>
		<description>An incredibly high-tech suit of armor made from ultra-durable plasteel using activated eltex. A massive eltex core accumulates energy into a psychic shield that absorbs incoming gunfire, projectiles and blasts, though not blows struck in melee.\n\nEvery hit the shield absorbs is stored as energy. Invictus releases it into the shield and the armor's servos: the shield is refilled and overcharged, and for a few seconds the wearer moves and strikes at a blinding pace.\n\nJusticiars of the Empire wear Promachos armor into battle against warlocks.</description>
		<techLevel>Spacer</techLevel>
		<tickerType>Normal</tickerType>
		<tradeTags>
			<li>ExoticMisc</li>
			<li>HiTechArmor</li>
			<li>Armor</li>
		</tradeTags>
		<generateCommonality>2</generateCommonality>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/PromachosArmor/PromachosArmor_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(1, 1)</drawSize>
		</graphicData>
		<statBases>
			<WorkToMake>55000</WorkToMake>
			<MaxHitPoints>340</MaxHitPoints>
			<Mass>11</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>1.12</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.48</ArmorRating_Blunt>
			<ArmorRating_Heat>0.58</ArmorRating_Heat>
			<Insulation_Cold>48</Insulation_Cold>
			<Insulation_Heat>38</Insulation_Heat>
			<EquipDelay>14</EquipDelay>
		</statBases>
		<costList>
			<ComponentSpacer>5</ComponentSpacer>
			<Plasteel>180</Plasteel>
			<Steel>30</Steel>
			<Uranium>25</Uranium>
			<VPE_Eltex MayRequire="VanillaExpanded.VPsycastsE">6</VPE_Eltex>
		</costList>
		<equippedStatOffsets>
			<MoveSpeed>-0.20</MoveSpeed>
			<PainShockThreshold>0.15</PainShockThreshold>
			<PsychicSensitivityOffset>0.25</PsychicSensitivityOffset>
			<PsychicEntropyMax>15</PsychicEntropyMax>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.3</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<recipeMaker>
			<researchPrerequisite>MJV_JusticiarGear</researchPrerequisite>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>140</displayPriority>
		</recipeMaker>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<tags>
				<li>RoyalTier7</li>
				<li>MJV_JusticiarGear</li>
			</tags>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/PromachosArmor/PromachosArmor</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<defaultOutfitTags>
				<li>Soldier</li>
				<li>Spacefarer</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<soundWear>Wear_PowerArmor</soundWear>
			<soundRemove>Remove_PowerArmor</soundRemove>
			<forceEyesVisibleForRotations>
				<li>1</li>
				<li>2</li>
				<li>3</li>
			</forceEyesVisibleForRotations>
			<abilities>
				<li>MJV_Invictus</li>
			</abilities>
		</apparel>
		<thingCategories Inherit="False">
			<li>ApparelArmor</li>
		</thingCategories>
		<comps>
			<li Class="JusticiarValor.CompProperties_PsychicShield">
				<energyMax>150</energyMax>
				<rechargePerSecond>10</rechargePerSecond>
				<rechargeDelayTicks>300</rechargeDelayTicks>
				<resetDelayTicks>2400</resetDelayTicks>
				<energyOnReset>0.4</energyOnReset>
				<chargePerDamage>1</chargePerDamage>
				<chargeMax>120</chargeMax>
				<overdriveEnergyFactor>1.5</overdriveEnergyFactor>
				<drawSize>2.05</drawSize>
				<absorbSound>EnergyShield_AbsorbDamage</absorbSound>
				<breakSound>EnergyShield_Broken</breakSound>
				<resetSound>EnergyShield_Reset</resetSound>
			</li>
		</comps>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.9,0.9,0.9,1)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33,1)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65,1)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>(0.3,0.3,0.3,1)</min>
					<max>(0.5,0.5,0.5,1)</max>
				</li>
			</options>
		</colorGenerator>
		<thingSetMakerTags>
			<li>RewardStandardHighFreq</li>
		</thingSetMakerTags>
		<tradeability>Sellable</tradeability>
	</ThingDef>


	<!-- Promachos Helm -->
	<ThingDef ParentName="ArmorHelmetMakeableBase">
		<defName>MJV_Apparel_ArmorHelmetPromachosHelmet</defName>
		<label>promachos helmet</label>
		<description>An incredibly high-tech helmet made from ultra-durable plasteel using activated eltex. It scans its surroundings in real time for murderous intent directed at its wearer; with each such thought it delivers an extra surge of stimulation into the wearer's brain, quickening their reactions, movement and awareness.\n\nBy channeling an additional charge through the eltex, the helmet resonates and releases a psychic wave around the wearer - Justiciar Valor, that throws enemies back, damages them and leaves them dazed. Its wearer cannot be arrested while conscious: an attempt triggers Justiciar Valor at once.</description>
		<techLevel>Spacer</techLevel>
		<tickerType>Normal</tickerType>
		<tradeTags>
			<li>ExoticMisc</li>
			<li>HiTechArmor</li>
			<li>Armor</li>
		</tradeTags>
		<generateCommonality>2</generateCommonality>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/PromachosHelmet/PromachosHelmet_icon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(1, 1)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>280</MaxHitPoints>
			<WorkToMake>32000</WorkToMake>
			<Mass>2.8</Mass>
			<Flammability>0.3</Flammability>
			<ArmorRating_Sharp>1.10</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.46</ArmorRating_Blunt>
			<ArmorRating_Heat>0.55</ArmorRating_Heat>
			<Insulation_Cold>4</Insulation_Cold>
			<Insulation_Heat>2</Insulation_Heat>
			<EquipDelay>5</EquipDelay>
		</statBases>
		<costList>
			<ComponentSpacer>3</ComponentSpacer>
			<Plasteel>90</Plasteel>
			<VPE_Eltex MayRequire="VanillaExpanded.VPsycastsE">8</VPE_Eltex>
		</costList>
		<equippedStatOffsets>
			<PainShockThreshold>0.10</PainShockThreshold>
			<PsychicSensitivityOffset>0.30</PsychicSensitivityOffset>
			<PsychicEntropyRecoveryRate>0.15</PsychicEntropyRecoveryRate>
			<PsychicEntropyMax>20</PsychicEntropyMax>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<recipeMaker>
			<researchPrerequisite>MJV_JusticiarGear</researchPrerequisite>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>141</displayPriority>
		</recipeMaker>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>RoyalTier7</li>
				<li>APM_Mechamancer</li>
				<li>MJV_JusticiarGear</li>
			</tags>
			<wornGraphicPath>Things/Pawn/Humanlike/Apparel/PromachosHelmet/PromachosHelmet</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<defaultOutfitTags>
				<li>Soldier</li>
				<li>Spacefarer</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<forceEyesVisibleForRotations>
				<li>1</li>
				<li>2</li>
				<li>3</li>
			</forceEyesVisibleForRotations>
			<abilities>
				<li>MJV_JusticiarValor</li>
			</abilities>
		</apparel>
		<comps>
			<li Class="JusticiarValor.CompProperties_ThreatSense">
				<range>30</range>
				<checkIntervalTicks>30</checkIntervalTicks>
				<maxThreats>5</maxThreats>
				<hediff>MJV_MurderousIntent</hediff>
			</li>
		</comps>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.9,0.9,0.9,1)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33,1)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65,1)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>(0.3,0.3,0.3,1)</min>
					<max>(0.5,0.5,0.5,1)</max>
				</li>
			</options>
		</colorGenerator>
		<thingSetMakerTags>
			<li>RewardSpecial</li>
		</thingSetMakerTags>
		<tradeability>Sellable</tradeability>
	</ThingDef>

</Defs>
