<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Energy psyspear. CompPsyOrbSynthesizer replaces CompEquippable and needs the spear to tick while wielded. -->
	<ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
		<defName>MJV_Weapon_EnergyPsySpear</defName>
		<label>energy psy-spear</label>
		<description>An ultra-tech spear built around eltex. It deals solid damage and has good armor penetration.\n\nAn internal energy system synthesizes psy-orbs and keeps them inside the spear. When its wielder is drafted or fighting, the orbs come out to circle them, and while the spear's auto-ability is switched on it launches them at enemies on its own, like a turret: each orb sears what it hits and slows it down for a few seconds.</description>
		<possessionCount>1</possessionCount>
		<tickerType>Normal</tickerType>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponMelee/MJV_Dory</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>1.75</drawSize>
		</graphicData>
		<uiIconScale>0.5</uiIconScale>
		<techLevel>Spacer</techLevel>
		<tradeability>Sellable</tradeability>
		<relicChance>0</relicChance>
		<statBases>
			<MarketValue>2800</MarketValue>
			<WorkToMake>32000</WorkToMake>
			<Mass>2.5</Mass>
		</statBases>
		<costList>
			<Plasteel>100</Plasteel>
			<ComponentSpacer>4</ComponentSpacer>
			<VPE_Eltex MayRequire="VanillaExpanded.VPsycastsE">4</VPE_Eltex>
		</costList>
		<recipeMaker>
			<researchPrerequisite>MJV_JusticiarGear</researchPrerequisite>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>142</displayPriority>
		</recipeMaker>
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2.0</cooldownTime>
				<armorPenetration>0.40</armorPenetration>
			</li>
			<li>
				<label>point</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>32</power>
				<cooldownTime>1.9</cooldownTime>
				<armorPenetration>0.80</armorPenetration>
			</li>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>18</power>
				<cooldownTime>2.1</cooldownTime>
				<armorPenetration>0.70</armorPenetration>
			</li>
		</tools>
		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
				<usableWithShields>true</usableWithShields>
				<weaponDraftedDrawOffsets>
					<north>
						<drawOffset>(-0.30, 0.00, 0.30)</drawOffset>
						<angleOffset>90</angleOffset>
					</north>
					<east>
						<drawOffset>(0.20, 0.00, 0.30)</drawOffset>
						<angleOffset>-30</angleOffset>
					</east>
					<south>
						<drawOffset>(0.30, 0.00, 0.30)</drawOffset>
						<angleOffset>-20</angleOffset>
					</south>
					<west>
						<drawOffset>(-0.20, 0.00, 0.30)</drawOffset>
						<angleOffset>30</angleOffset>
					</west>
				</weaponDraftedDrawOffsets>
			</li>
		</modExtensions>
		<weaponTags>
			<li>SpacerMeleeAdvanced</li>
			<li>JusticiarMelee</li>
		</weaponTags>
		<tradeTags>
			<li>ExoticMisc</li>
			<li>WeaponMelee</li>
		</tradeTags>
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable"/>
			<li Class="JusticiarValor.CompProperties_PsyOrbSynthesizer">
				<synthesisTicks>300</synthesisTicks>
				<maxOrbs>3</maxOrbs>
				<range>15.9</range>
				<launchIntervalTicks>60</launchIntervalTicks>
				<projectile>MJV_Projectile_PsyOrb</projectile>
				<launchSound>Psycast_Skip_Pulse</launchSound>
				<toggleIconPath>UI/Abilities/MJV_PsyOrb</toggleIconPath>
			</li>
			<li Class="CompProperties_Styleable"/>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponMelee</nameMaker>
				<descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
		</comps>
	</ThingDef>

	<!-- The psy-orb the spear launches. Drawn by Projectile_PsyOrb through the MJV_PsyOrb shader; the texture is unused. -->
	<ThingDef ParentName="BaseBullet">
		<defName>MJV_Projectile_PsyOrb</defName>
		<label>psy-orb</label>
		<thingClass>JusticiarValor.Projectile_PsyOrb</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Charge_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>MoteGlow</shaderType>
			<drawSize>0.7</drawSize>
		</graphicData>
		<projectile>
			<damageDef>MJV_PsyBurn</damageDef>
			<damageAmountBase>11</damageAmountBase>
			<armorPenetrationBase>0.35</armorPenetrationBase>
			<stoppingPower>0.5</stoppingPower>
			<speed>24</speed>
		</projectile>
		<modExtensions>
			<li Class="JusticiarValor.PsyOrbExtension">
				<slowHediff>MJV_PsyOrbSlow</slowHediff>
				<impactSound>PsycastPsychicEffect</impactSound>
				<drawSize>0.7</drawSize>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- Energy psyblade. Celestial Pierce comes with it through CompEquippableAbility. -->
	<ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
		<defName>MJV_MeleeWeapon_EnergyPsyblade</defName>
		<label>energy psyblade</label>
		<description>An ultra-tech sword built around eltex. It deals solid damage, though its armor penetration is only moderate.\n\nIts wielder can use Celestial Pierce: the blade conjures a psychic glintblade from its point and thrusts it forward, impaling everyone in its path up to three cells away, friend or foe.</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponMelee/MJV_Xiphos</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1, 1)</drawSize>
		</graphicData>
		<tradeability>Sellable</tradeability>
		<relicChance>0</relicChance>
		<statBases>
			<MarketValue>2800</MarketValue>
			<WorkToMake>32000</WorkToMake>
			<Mass>2.5</Mass>
		</statBases>
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2.0</cooldownTime>
				<armorPenetration>0.42</armorPenetration>
			</li>
			<li>
				<label>point</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>18</power>
				<cooldownTime>1.6</cooldownTime>
				<armorPenetration>0.48</armorPenetration>
			</li>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>24</power>
				<cooldownTime>1.4</cooldownTime>
				<armorPenetration>0.70</armorPenetration>
			</li>
		</tools>
		<costList>
			<Plasteel>80</Plasteel>
			<ComponentSpacer>4</ComponentSpacer>
			<VPE_Eltex MayRequire="VanillaExpanded.VPsycastsE">3</VPE_Eltex>
		</costList>
		<recipeMaker>
			<researchPrerequisite>MJV_JusticiarGear</researchPrerequisite>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
			<displayPriority>143</displayPriority>
		</recipeMaker>
		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
				<usableWithShields>true</usableWithShields>
			</li>
		</modExtensions>
		<weaponTags>
			<li>SpacerMeleeAdvanced</li>
			<li>JusticiarMelee</li>
		</weaponTags>
		<tradeTags>
			<li>ExoticMisc</li>
			<li>WeaponMelee</li>
		</tradeTags>
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_EquippableAbility">
				<abilityDef>MJV_CelestialPierce</abilityDef>
			</li>
			<li Class="CompProperties_Styleable"/>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponMelee</nameMaker>
				<descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
		</comps>
	</ThingDef>
</Defs>
