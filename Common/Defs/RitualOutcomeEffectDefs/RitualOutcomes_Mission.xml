       and the satisfaction it brings come from the window itself, and the sermon applies its own outcome
       (JusticiarValor.LordJob_MJV_Sermon, MissionRecord). -->
  <RitualOutcomeEffectDef>
    <defName>MJV_ImperialSermon</defName>
    <description>The more of the colony attends beyond the justiciar's minimum, the more he is pleased, and the more goodwill he brings back to the Empire.</description>
    <givesDevelopmentPoints>false</givesDevelopmentPoints>
    <warnOnLowQuality>false</warnOnLowQuality>
    <allowAttachableOutcome>false</allowAttachableOutcome>
    <comps />
  </RitualOutcomeEffectDef>

</Defs>
