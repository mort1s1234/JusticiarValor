<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Promachos helmet: severity = hostile pawns attacking or aiming at the wearer (set by CompThreatSense). -->
	<HediffDef>
		<defName>MJV_MurderousIntent</defName>
		<label>sensed murderous intent</label>
		<description>The Promachos helmet senses hostile intent directed at its wearer. With each source of such a thought, it sends an additional stimulating impulse into the wearer's brain, quickening their reactions and movement. The more enemies aim at the wearer, the stronger this impulse.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.55, 0.95, 0.85)</defaultLabelColor>
		<isBad>false</isBad>
		<initialSeverity>1</initialSeverity>
		<maxSeverity>5</maxSeverity>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<label>alert</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>0.04</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>0.03</offset>
					</li>
				</capMods>
				<statOffsets>
					<MeleeDodgeChance>3</MeleeDodgeChance>
				</statOffsets>
				<statFactors>
					<AimingDelayFactor>0.94</AimingDelayFactor>
				</statFactors>
			</li>
			<li>
				<minSeverity>1.5</minSeverity>
				<label>keen</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>0.08</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>0.06</offset>
					</li>
				</capMods>
				<statOffsets>
					<MeleeDodgeChance>6</MeleeDodgeChance>
				</statOffsets>
				<statFactors>
					<AimingDelayFactor>0.88</AimingDelayFactor>
				</statFactors>
			</li>
			<li>
				<minSeverity>3.5</minSeverity>
				<label>battle trance</label>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>0.12</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>0.08</offset>
					</li>
				</capMods>
				<statOffsets>
					<MeleeDodgeChance>9</MeleeDodgeChance>
					<MeleeHitChance>3</MeleeHitChance>
				</statOffsets>
				<statFactors>
					<AimingDelayFactor>0.80</AimingDelayFactor>
				</statFactors>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>MJV_PsychicDaze</defName>
		<label>psychic daze</label>
		<description>Reeling from an eltex psychic wave. Movement and awareness are dulled for a few seconds.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.75, 0.7, 1)</defaultLabelColor>
		<isBad>true</isBad>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<statFactors>
					<MoveSpeed>0.65</MoveSpeed>
					<AimingDelayFactor>1.2</AimingDelayFactor>
				</statFactors>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>270~330</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>MJV_PsyOrbSlow</defName>
		<label>psy-orb drag</label>
		<description>A psy-orb's residual field clings to this creature's nerves, slowing its movement.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.55, 0.95, 0.85)</defaultLabelColor>
		<isBad>true</isBad>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<statFactors>
					<MoveSpeed>0.7</MoveSpeed>
				</statFactors>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>180~240</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>MJV_InvictusOverdrive</defName>
		<label>Invictus overdrive</label>
		<description>The Promachos armor dumped its stored energy into the shield and servos. The wearer moves and strikes at a blinding pace.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.75, 0.7, 1)</defaultLabelColor>
		<isBad>false</isBad>
		<everCurableByItem>false</everCurableByItem>
		<stages>
			<li>
				<statOffsets>
					<MoveSpeed>2.6</MoveSpeed>
					<MeleeDodgeChance>10</MeleeDodgeChance>
					<MeleeHitChance>4</MeleeHitChance>
				</statOffsets>
				<statFactors>
					<MeleeCooldownFactor>0.68</MeleeCooldownFactor>
					<AimingDelayFactor>0.72</AimingDelayFactor>
					<RangedCooldownFactor>0.80</RangedCooldownFactor>
				</statFactors>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>480</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
			<li Class="JusticiarValor.HediffCompProperties_Afterimages">
				<intervalTicks>3</intervalTicks>
				<lifeSeconds>0.42</lifeSeconds>
				<colors>
					<li>(0.45, 0.95, 0.85, 1)</li>
					<li>(0.35, 0.78, 1, 1)</li>
					<li>(0.68, 0.52, 1, 1)</li>
					<li>(1, 0.48, 0.78, 1)</li>
				</colors>
			</li>
		</comps>
	</HediffDef>

</Defs>