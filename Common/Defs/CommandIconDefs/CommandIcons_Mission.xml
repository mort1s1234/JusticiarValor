<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- On the justiciar while he waits for the colony's answer (MJV_CommandHoldSermon, MJV_CommandRefuseSermon). -->
  <JusticiarValor.CommandIconDef>
    <defName>MJV_HoldSermon</defName>
    <iconPath>UI/Abilities/MJV_Sermon</iconPath>
  </JusticiarValor.CommandIconDef>

  <JusticiarValor.CommandIconDef>
    <defName>MJV_RefuseSermon</defName>
    <iconPath>UI/Designators/Cancel</iconPath>
  </JusticiarValor.CommandIconDef>

  <!-- During the sermon: on each listener (MJV_CommandLeaveSermon), and on every colonist taking part
       (MJV_CommandCancelSermon). -->
  <JusticiarValor.CommandIconDef>
    <defName>MJV_LeaveSermon</defName>
    <iconPath>UI/Abilities/MJV_Sermon</iconPath>
  </JusticiarValor.CommandIconDef>

  <JusticiarValor.CommandIconDef>
    <defName>MJV_CancelSermon</defName>
    <iconPath>UI/Designators/Cancel</iconPath>
  </JusticiarValor.CommandIconDef>

</Defs>