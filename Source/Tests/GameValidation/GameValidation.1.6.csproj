<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-game validation for RimWorld 1.6 (RIMWORLD_1_6): the same sources as GameValidation.csproj, against the 1.6 game's
       assemblies (Krafs.Rimworld.Ref 1.6.4871), Harmony 2 and 1.6/Assemblies/JusticiarValor.dll. Loaded as a temporary
       test mod by ../Run-GameValidation.ps1 -Version 1.6. Never part of the release. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>JusticiarValorValidation</AssemblyName>
    <RootNamespace>JusticiarValorValidation</RootNamespace>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <JVHarmonyDir Condition="'$(JVHarmonyDir)' == ''">$(JVWorkshopDir)\2009463077\1.6\Assemblies</JVHarmonyDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
    <Reference Include="0Harmony">
      <HintPath>$(JVHarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="JusticiarValor">
      <HintPath>$(JVModRoot)\1.6\Assemblies\JusticiarValor.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VEF.Abilities, to cast Vanilla Psycasts Expanded's psycasts at the Warlockbane shield. -->
    <Reference Include="VEF">
      <HintPath>$(JVWorkshopDir)\2023507013\1.6\Assemblies\VEF.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
