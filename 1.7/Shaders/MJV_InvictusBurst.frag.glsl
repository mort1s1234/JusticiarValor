// A cell of the packed Piloto sheet at local coordinates 0..1 (outside them it is transparent). Mask cells hold their
// light in every channel; colour cells hold straight RGBA.
vec4 mjv_sheet(vec2 local, vec4 rect)
{
    vec2 inside = step(vec2(0.0, 0.0), local) * step(local, vec2(1.0, 1.0));
    vec2 uv = vec2(rect.x, rect.y) + clamp(local, vec2(0.0, 0.0), vec2(1.0, 1.0)) * vec2(rect.z, rect.w);
    return MJV_TEX(MJV_MAINTEX_UV(uv)) * (inside.x * inside.y);
}

float mjv_sheetMask(vec2 local, vec4 rect)
{
    return mjv_sheet(local, rect).a;
}

// One sprite of a cell that holds a cols x rows grid of them, numbered from the top left as in the source image.
vec4 mjv_sheetSprite(vec2 local, vec4 rect, float index, float cols, float rows)
{
    float i = floor(MJV_MOD(index, cols * rows));
    vec2 cell = vec2(MJV_MOD(i, cols), rows - 1.0 - floor(i / cols));
    vec4 sub = vec4(rect.x + cell.x * rect.z / cols, rect.y + cell.y * rect.w / rows, rect.z / cols, rect.w / rows);
    return mjv_sheet(local, sub);
}

// Glow of a mask in the armor palette, as the Piloto clips are coloured: light 0..1, premultiplied.
vec4 mjv_glow(float light, float intensity, float opacity, vec4 col)
{
    float l = mjv_sat(light);
    return vec4(mjv_sage(l) * l * max(0.0, intensity) * opacity * col.rgb, l * opacity * 0.95 * col.a);
}
